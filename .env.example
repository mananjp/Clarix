# ---- Clarix Backend - Environment Template ----
# Copy to `.env` and fill in your values. Never commit the real `.env`.

# ---- Database ----
# Set USE_POSTGRES=true to use the local Docker PostgreSQL (see docker-compose.yml).
# Leave unset/empty to use SQLite at data/sfdr.db (no Postgres needed for local dev).
USE_POSTGRES=false

# Postgres connection settings (used when USE_POSTGRES=true)
# NOTE: 55432 avoids collision with any local/native Postgres on 5432
POSTGRES_USER=clarix
POSTGRES_PASSWORD=clarix
POSTGRES_DB=clarix
POSTGRES_HOST=localhost
POSTGRES_PORT=55432

# (Legacy) managed Neon PostgreSQL - overrides DATABASE_URL when set
# NEON_URL=postgresql://user:pass@ep-host.aws.neon.tech/neondb?sslmode=require

# Or an explicit connection string
# DATABASE_URL=sqlite:///./data/sfdr.db

# ---- LLM: Groq API key ----
# Leave empty to use the local simulation/fallback engine.
# Obtain a key from https://console.groq.com/keys
GROQ_API_KEY=

# ---- JWT signing secret (required) ----
# Generate a strong one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-random-64-hex-string

# ---- CORS allow-list (comma-separated) ----
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000

# ---- Third-party ESG data feed (Phase 2.1) ----
# Provider: sustainalytics | msci | mock (default mock — no credentials needed)
ESG_FEED_PROVIDER=mock
# SUSTAINALYTICS_API_KEY=
# SUSTAINALYTICS_BASE_URL=https://api.sustainalytics.com
# MSCI_ESG_API_KEY=
# MSCI_ESG_BASE_URL=https://esg.msci.com/api/v1

# ---- EU data residency / hosting (Phase 2.3) ----
# Single, documentable answer for EU asset-manager procurement review.
DATA_RESIDENCY_REGION=eu-central-1
DATA_RESIDENCY_VENDOR=aws
DATA_RESIDENCY_STATEMENT=Regulatory disclosure data is hosted within the European Union.

# ---- Background jobs / Celery (Phase 4.3) ----
# Leave empty to run batch processing synchronously in-process (dev/test).
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/0
